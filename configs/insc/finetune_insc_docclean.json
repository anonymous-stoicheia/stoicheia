{
  "name": "insc_ft_docclean",
  "seed": 0,
  "d_model": 1024,
  "depth": 32,
  "char_window": 256,
  "attn": "flex",
  "compile": true,
  "seq_len": 8192,
  "micro_batch": 4,
  "grad_accum": 2,
  "lr": 0.0001,
  "wd": 0.1,
  "warmup": 200,
  "total_steps": 12000,
  "decay_len": 1500,
  "eval_every": 250,
  "eval_n": 256,
  "stall_window": 8,
  "stall_eps": 0.002,
  "anneal_patience": 3,
  "num_workers": 8,
  "log_every": 20,
  "lam": 0.1,
  "torso": "$GCB_DATA/runs/gcb_doc_clean/best.pt",
  "iphi_shards": "$INS_DATA/shards/iphi_punct",
  "gcb_shards": "$GCB_DATA/folds/doc_clean/shards/v1_punct",
  "dev_exclude": "",
  "dev_domain": "iphi",
  "mix": {"iphi": 1.0, "iphi_syn": 0.5, "gold": 0.15, "silver": 0.15},
  "noise": {"w_span": 0.45, "w_word": 0.15, "w_elastic": 0.0, "w_iid": 0.15,
            "w_halfword": 0.15, "w_substitute": 0.10, "span_mean": 4.0, "span_max": 12},
  "out_dir": "$INS_DATA/runs/insc_ft_docclean"
}
