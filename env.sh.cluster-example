# env.sh.cluster-example
#
# This file is NOT sourced by anything — it is kept verbatim for provenance/reference
# only. It concatenates the five original, cluster-specific env.sh files from the
# source repos that were consolidated into this one (GreekCharBERT, CharDiff-grc_tagger,
# CharDiff-grc_syntax, CharDiff-grc_meter, CharDiff-grc_inscriptions). They show exactly
# what env vars / cache dirs / container binds each sub-project needed on the original
# NAISS/Berzelius-style cluster (hardcoded /nobackup paths, a specific SLURM account,
# an apptainer .sif, etc.) before genericization into the single env.sh at the repo root.
#
# The GreekCharBERT one is the PRIMARY reference — every other repo's env.sh sourced it
# and only added its own PYTHONPATH/data-root aliases on top.

# ============================================================================
# 1/5 - GreekCharBERT/env.sh  (primary reference; core pretraining env)
# ============================================================================
#!/bin/bash
# source this on login (x86) or GPU nodes (aarch64) alike.
#   source /nobackup/proj/flash/dionysus/shared/GreekCharBERT/env.sh

export GCB_ROOT=/nobackup/proj/flash/dionysus/shared/GreekCharBERT   # this package
export GCB_DATA=/nobackup/proj/disk/dionysus/shared/GreekCharBERT    # shards, checkpoints, runs (28P tier)

# Training container (aarch64, GPU nodes only): NGC torch 2.11 + FA + TE-FP8, verified on GH200.
# Hardlinked into this project (same filesystem, zero extra space) so no external path is needed.
export SIF=$GCB_ROOT/containers/swift-megatron.sif
export APPTAINER_BINDS="-B /nobackup/proj/flash/dionysus/shared -B /nobackup/proj/disk/dionysus/shared"

# Keep every cache off the 30 GB home directory.
export HF_HOME=$GCB_DATA/cache/huggingface
export XDG_CACHE_HOME=$GCB_DATA/cache/xdg
export TRITON_CACHE_DIR=$GCB_DATA/cache/triton
export TORCHINDUCTOR_CACHE_DIR=$GCB_DATA/cache/inductor
mkdir -p "$XDG_CACHE_HOME" "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR" 2>/dev/null

# x86 CPU-side venv (data pipeline / normalization). GPU-side python comes from $SIF.
# Built by scripts/setup_venv.sh from requirements-x86.txt (self-contained, uv-managed).
export GCB_VENV=$GCB_ROOT/.venv-x86
[ -f "$GCB_VENV/bin/activate" ] && source "$GCB_VENV/bin/activate"

export PYTHONPATH=$GCB_ROOT:${PYTHONPATH:-}
# backward-compat alias: train/data.py reads GRC_DATA
export GRC_DATA=$GCB_DATA

