# ============================================================================
# 3/5 - CharDiff-grc_syntax/env.sh
# ============================================================================
#!/bin/bash
# source this on login (x86) or GPU nodes (aarch64) alike.
#   source /nobackup/proj/flash/dionysus/shared/CharDiff-grc_syntax/env.sh
# Dependency parsing (AGDT head/deprel, LAS) over OGA — a 3-arm encoder ablation:
#   lemma  tagger-predicted lemma+morph -> LemmaDiff-grc encoder
#   char   raw text -> CharDiff-grc encoder (word-pooled)
#   fused  both, concatenated
export SYN_ROOT=/nobackup/proj/flash/dionysus/shared/CharDiff-grc_syntax
export TAGGER_ROOT=/nobackup/proj/flash/dionysus/shared/CharDiff-grc_tagger
export LDF_ROOT=/nobackup/proj/flash/dionysus/shared/LemmaDiff-grc
source /nobackup/proj/flash/dionysus/shared/GreekCharBERT/env.sh
export SYN_DATA=$GCB_DATA/parser_data
export CHARDIFF_CKPT=$GCB_DATA/runs/greekcharbert_anneal_staged/best.pt
export LEMMADIFF_CKPT=/nobackup/proj/disk/dionysus/shared/LemmaDiff-grc/runs/lemmadiff_v2_anneal/soup.pt
export LDF_VOCAB=/nobackup/proj/disk/dionysus/shared/LemmaDiff-grc/vocab_v2.json
export PYTHONPATH=$SYN_ROOT:$TAGGER_ROOT:$LDF_ROOT:$GCB_ROOT:${PYTHONPATH:-}
mkdir -p "$SYN_DATA" 2>/dev/null

