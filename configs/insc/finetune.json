{
  "name": "insc_finetune",
  "seed": 0,
  "d_model": 1024,
  "depth": 32,
  "char_window": 256,
  "attn": "flex",
  "compile": true,
  "seq_len": 8192,
  "micro_batch": 4,
  "grad_accum": 2,
  "lr": 0.0001,
  "wd": 0.1,
  "warmup": 200,
  "total_steps": 3000,
  "num_workers": 8,
  "log_every": 20,
  "ckpt_every": 250,
  "lam": 0.1,
  "torso": "$INS_TORSO",
  "iphi_shards": "$INS_DATA/shards/iphi_punct",
  "gcb_shards": "$GCB_DATA/shards/v1_punct",
  "mix": {"iphi": 1.0, "iphi_syn": 0.5, "gold": 0.15, "silver": 0.15},
  "noise": {"w_span": 0.45, "w_word": 0.15, "w_elastic": 0.0, "w_iid": 0.15,
            "w_halfword": 0.15, "w_substitute": 0.10, "span_mean": 4.0, "span_max": 12},
  "out_dir": "$INS_DATA/runs/insc_finetune"
}
